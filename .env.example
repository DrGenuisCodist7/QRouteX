# ==============================================================================
# QRouteX — Quantum Logistics OS Environment Configuration
# ==============================================================================

# Application Metadata
NEXT_PUBLIC_APP_NAME=QRouteX
NEXT_PUBLIC_APP_TAGLINE="Quantum Logistics OS"
NEXT_PUBLIC_APP_VERSION=1.0.0

# Geolocation & Mapping Defaults (Used as graceful fallback if user location is disabled)
NEXT_PUBLIC_DEFAULT_LAT=17.3850
NEXT_PUBLIC_DEFAULT_LNG=78.4867
NEXT_PUBLIC_DEFAULT_CITY="Hyderabad"
NEXT_PUBLIC_DEFAULT_ZOOM=13

# Feature Flags
NEXT_PUBLIC_ENABLE_QUANTUM_SIMULATOR=true
NEXT_PUBLIC_ENABLE_REAL_GEOLOCATION=true
NEXT_PUBLIC_ENABLE_DISRUPTION_SIMULATION=true

# Future Backend Integrations (Optional when connecting to live microservices)
# NEXT_PUBLIC_API_BASE_URL=https://api.qroutex.ai/v1
# NEXT_PUBLIC_QUANTUM_BACKEND_URL=https://quantum.qroutex.ai/qaoa
